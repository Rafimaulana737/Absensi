{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER", "STUDENT", "PARENT"] },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "qrData": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Logs of student entry and exit",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "status": { "type": "string", "enum": ["PRESENT", "LATE", "ABSENT", "PERMISSION"] }
      },
      "required": ["studentId", "classId", "timestamp", "type", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time alerts for parents and teachers",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["userId", "title", "message", "timestamp", "read"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance history"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
